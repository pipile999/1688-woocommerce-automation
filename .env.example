# WooCommerce
WOOCOMMERCE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# OpenAI - optional for description/image intelligence modules
OPENAI_API_KEY=

# Google Ads - optional for Keyword Planner module
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Image defaults
IMAGE_MAX_EDGE=1800
IMAGE_WEBP_QUALITY=83
IMAGE_TARGET_MAX_KB=300

# Pricing rule: price / divisor / exchange divisor
PRICE_DIVISOR=0.7
CURRENCY_DIVISOR=6.7
